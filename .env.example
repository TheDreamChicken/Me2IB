# Copy to .env.local and fill in from Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Set this to the canonical deployed URL in production (no trailing slash).
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional — enables the AI features (document review, plan generation, outreach,
# LinkedIn import, opportunity scan). Add EITHER key; both work for everything.
# Anthropic: https://platform.claude.com   OpenAI: https://platform.openai.com
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# If both keys are set, Anthropic is used unless you force one:
# AI_PROVIDER=openai
# The exact model is picked in-app (Account -> AI engine, admin only) and is
# stored in the app_settings table; without a setting, the default is
# claude-opus-4-8 (Anthropic) / gpt-5.6-sol (OpenAI).
